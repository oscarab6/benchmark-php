{
  "name": "pc-umu/benchmark-php",
  "description": "Microservicio PHP del proyecto global: mide el tiempo de ejecución de algoritmos clásicos",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}

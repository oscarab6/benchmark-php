#!/bin/sh
if [ ! -f vendor/bin/php-cs-fixer ]; then
  echo "Falta PHP-CS-Fixer: ejecuta 'composer install' antes de hacer commit."
  exit 1
fi

echo "Formateando con PHP-CS-Fixer..."
php vendor/bin/php-cs-fixer fix --quiet || exit 1
git add -u          # re-añade los archivos que PHP-CS-Fixer haya reformateado
